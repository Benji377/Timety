<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower, where one set of rules covers both cloud backup and device transfers.
     Excludes everything so that nothing reaches cloud backup; see data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
